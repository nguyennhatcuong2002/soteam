# --- LLM connection (GreenNode MaaS — OpenAI-compatible) ---
# Required: API key (lấy từ email BTC)
LLM_API_KEY=<api_key_từ_email_BTC>

# Endpoint của GreenNode MaaS (lưu ý: phải có hậu tố /v1)
OPENAI_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1

# Model name
MODEL_NAME=minimax/minimax-m2.5

# Generation settings
TEMPERATURE=0.3
MAX_TOKENS=2048

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Set to 1 to enable auto-reload during development
RELOAD=

# Path to the system prompt file (defaults to ./CLAUDE.md)
# SYSTEM_PROMPT_PATH=CLAUDE.md

LOG_LEVEL=INFO
